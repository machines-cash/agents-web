NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_AGENT_ORIGIN=http://localhost:3002
NEXT_PUBLIC_LLMS_CONSUMER_URL=http://localhost:8080/llms-consumer.txt
NEXT_PUBLIC_MACHINES_CONNECT_CLIENT_ID=agent_web
NEXT_PUBLIC_MACHINES_CONNECT_REDIRECT_URI=http://localhost:3002/machines
NEXT_PUBLIC_MACHINES_CONNECT_SCOPE=*

# Local-connect defaults:
# If NEXT_PUBLIC_API_BASE_URL is unset, agents-web auto-derives http://<current-host>:8080.
# If NEXT_PUBLIC_APP_ORIGIN is unset, agents-web auto-derives http://<current-host>:3000.
