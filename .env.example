# External contributors should run the frontend locally and use hosted APIs.
# Recommended (dev/sandbox API):
NEXT_PUBLIC_API_BASE_URL=https://dev-api.machines.cash
NEXT_PUBLIC_APP_ORIGIN=https://sandbox.machines.cash
NEXT_PUBLIC_AGENT_ORIGIN=http://localhost:3002
NEXT_PUBLIC_LLMS_CONSUMER_URL=https://dev-api.machines.cash/llms-consumer.txt
NEXT_PUBLIC_MACHINES_CONNECT_CLIENT_ID=agent_web
NEXT_PUBLIC_MACHINES_CONNECT_REDIRECT_URI=http://localhost:3002/machines
NEXT_PUBLIC_MACHINES_CONNECT_SCOPE=*

# Optional prod profile overrides:
# NEXT_PUBLIC_API_BASE_URL=https://api.machines.cash
# NEXT_PUBLIC_APP_ORIGIN=https://app.machines.cash
# NEXT_PUBLIC_LLMS_CONSUMER_URL=https://api.machines.cash/llms-consumer.txt
